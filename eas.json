{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "staging": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "staging",
      "uploadSourceMaps": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "uploadSourceMaps": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "staging": {
      "android": {
        "track": "internal",
        "changesNotSentForReview": true,
        "releaseStatus": "completed"
      },
      "ios": {
        "groups": ["Truelabels Internal"]
      }
    },
    "production": {
      "android": {
        "track": "internal",
        "changesNotSentForReview": true,
        "releaseStatus": "completed"
      },
      "ios": {
        "groups": ["Truelabels Internal"]
      }
    }
  }
}
